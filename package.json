{
  "name": "field-work",
  "license": "0BSD",
  "version": "1.1.1",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "npm dedupe --prefer-dedupe && patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "icons:sync": "node scripts/sync-android-launcher-icons.mjs",
    "icons:android:sync": "node scripts/sync-android-launcher-icons.mjs",
    "storage:push-vps": "node scripts/push-vps-storage-metric.js",
    "billing:reminders:tick": "node scripts/subscription-email-worker.js",
    "billing:reminders:legacy": "node scripts/subscription-reminders-tick.js",
    "billing:email-worker:tick": "node scripts/subscription-email-worker.js",
    "yandex:reconcile:tick": "node scripts/yandex-media-reconcile-tick.js",
    "lint": "eslint App.js index.js useAppLastSeen.js app components hooks lib providers screens src theme",
    "lint:fix": "eslint App.js index.js useAppLastSeen.js app components hooks lib providers screens src theme --fix",
    "typecheck": "tsc --noEmit",
    "test:release": "node scripts/validate-release.mjs && node scripts/test-finance-v2.mjs && node scripts/test-admin-directory-lists.mjs && node scripts/test-image-size-security.mjs && node scripts/test-edge-security-regressions.mjs && node scripts/test-background-sync-outcome.mjs && node scripts/test-offline-banner-state.mjs && node scripts/test-media-upload-policy.mjs",
    "test:ios-config": "node scripts/validate-ios-introspection.mjs",
    "test:finance": "node scripts/test-finance-v2.mjs",
    "test:security-regressions": "node scripts/test-image-size-security.mjs && node scripts/test-edge-security-regressions.mjs && node scripts/test-media-upload-policy.mjs",
    "security:secrets": "node scripts/check-no-client-secrets.mjs",
    "release:check": "npm run security:secrets && npm run lint && npm run typecheck && npm run test:release && npm run test:ios-config && npm run doctor",
    "doctor": "expo-doctor",
    "build:android:apk": "node scripts/build-android-release.mjs apk",
    "build:android:aab": "node scripts/build-android-release.mjs aab",
    "build:android:clean": "node scripts/build-android-release.mjs clean",
    "build:eas:android:apk": "eas build --platform android --profile production-apk",
    "build:eas:android:aab": "eas build --platform android --profile production",
    "build:eas:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.53.0",
    "@tanstack/query-async-storage-persister": "^5.87.4",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-query-persist-client": "^5.87.4",
    "base64-arraybuffer": "^1.0.2",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "expo": "~57.0.23",
    "expo-application": "~57.0.3",
    "expo-background-task": "~57.0.18",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-contacts": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-media-library": "~57.0.5",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.18",
    "expo-updates": "~57.0.22",
    "express": "^5.2.1",
    "nodemailer": "^9.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-image-pan-zoom": "^2.1.12",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.1",
    "react-native-worklets": "0.10.1",
    "react-native-zoom-toolkit": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/js": "^9.39.1",
    "@expo/image-utils": "0.8.8",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "expo-doctor": "1.20.4",
    "jimp-compact": "0.16.1",
    "patch-package": "8.0.1",
    "pngjs": "3.4.0",
    "typescript": "5.9.2"
  },
  "resolutions": {
    "react-native-safe-area-context": "~5.7.0"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "@xmldom/xmldom": "0.8.15",
    "baseline-browser-mapping": "2.11.24",
    "browserslist": "4.29.0",
    "js-yaml": "4.3.2",
    "postcss": "^8.5.10",
    "qs": "6.16.0",
    "query-string": "9.5.1",
    "uuid": "^11.1.1",
    "react-native-safe-area-context": "~5.7.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true
}
