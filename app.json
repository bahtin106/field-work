{
  "expo": {
    "name": "Монитор",
    "slug": "work-orders-app",
    "version": "1.1.0",
    "orientation": "default",
    "scheme": "workorders",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F2F7"
    },
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.monitorapp.monitor",
      "versionCode": 11,
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/app-icon-android-foreground.png",
        "monochromeImage": "./assets/branding/app-mark-monochrome.png",
        "backgroundColor": "#68C2EE"
      },
      "runtimeVersion": "1.1.0"
    },
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "androidStatusBar": {
      "barStyle": "dark-content"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "extra": {
      "eas": {
        "projectId": "3c645715-1637-4502-979c-d4690c6cf1e2"
      }
    },
    "owner": "bahtin106",
    "plugins": [
      "expo-router",
      "./plugins/withMapAppQueries",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#F2F2F7"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notifications/notification-icon.png",
          "defaultChannel": "app-notify"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите приложению доступ к камере для съёмки фото заказов"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Разрешите приложению «Монитор» доступ к контактам для выбора номера телефона"
        }
      ],
      "expo-background-task"
    ],
    "updates": {
      "url": "https://u.expo.dev/3c645715-1637-4502-979c-d4690c6cf1e2"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "icon": "./assets/branding/app-icon-ios.png",
      "bundleIdentifier": "com.monitorapp.monitor",
      "runtimeVersion": "1.1.0",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "yandexmaps",
          "yandexnavi",
          "comgooglemaps"
        ]
      }
    }
  }
}
